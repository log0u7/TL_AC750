config led 'led_power'
	option name 'power'
	option sysfs 'green:power'
	option trigger 'default-on'

config led 'led_lan'
	option name 'lan'
	option sysfs 'green:lan'
	option trigger 'switch0'
	list port_mask '0x1e'

config led 'led_wan'
	option name 'wan'
	option sysfs 'green:wan'
	option trigger 'switch0'
	list port_mask '0x01'

config led 'led_wlan'
	option name 'wlan'
	option sysfs 'green:wlan'
	option trigger 'netdev'
	option dev 'wlan0'
	list mode 'link'
	list mode 'tx'
	list mode 'rx'

config led 'led_wlan5'
	option name 'wlan5'
	option sysfs 'mt76-phy1'
	option trigger 'netdev'
	option dev 'wlan1'
	list mode 'link'
	list mode 'tx'
	list mode 'rx'

config led 'led_usb'
	option name 'usb'
	option sysfs 'green:usb'
	option trigger 'usbport'

config led 'led_wps'
	option name 'wps'
	option sysfs 'green:wps'
	option trigger 'none'
